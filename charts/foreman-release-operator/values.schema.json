{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["nameOverride", "fullnameOverride", "imagePullSecrets", "image", "controller", "health", "service", "monitoring", "serviceAccount", "rbac", "resources"],
  "allOf": [
    {
      "if": { "properties": { "serviceAccount": { "properties": { "create": { "const": false } } } } },
      "then": { "properties": { "serviceAccount": { "properties": { "name": { "minLength": 1 } } } } }
    }
  ],
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicas", "pollSeconds", "commandTimeoutSeconds", "commandTerminationGraceSeconds", "releaseLeaseDurationSeconds", "leaderLeaseName", "leaderLeaseDurationSeconds", "terminationGracePeriodSeconds"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1, "maximum": 5 },
        "pollSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "commandTimeoutSeconds": { "type": "integer", "minimum": 5, "maximum": 1800 },
        "commandTerminationGraceSeconds": { "type": "integer", "minimum": 1, "maximum": 30 },
        "releaseLeaseDurationSeconds": { "type": "integer", "minimum": 30, "maximum": 3600 },
        "leaderLeaseName": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "leaderLeaseDurationSeconds": { "type": "integer", "minimum": 30, "maximum": 300 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 5, "maximum": 300 }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "readinessMaxStalenessSeconds"],
      "properties": {
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "readinessMaxStalenessSeconds": { "type": "integer", "minimum": 15, "maximum": 3600 }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotations", "type"],
      "properties": {
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "type": { "type": "string", "enum": ["ClusterIP"] }
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceMonitor", "prometheusRule", "grafanaDashboard"],
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "labels", "interval", "scrapeTimeout"],
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": { "type": "object", "additionalProperties": { "type": "string" } },
            "interval": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$" },
            "scrapeTimeout": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$" }
          }
        },
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "labels"],
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "grafanaDashboard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "labels"],
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "clusterPreflight"],
      "properties": {
        "create": { "type": "boolean" },
        "clusterPreflight": { "type": "boolean" }
      }
    },
    "resources": { "type": "object" }
  }
}
