{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["nameOverride", "fullnameOverride", "imagePullSecrets", "image", "controller", "serviceAccount", "rbac", "resources"],
  "allOf": [
    {
      "if": { "properties": { "serviceAccount": { "properties": { "create": { "const": false } } } } },
      "then": { "properties": { "serviceAccount": { "properties": { "name": { "minLength": 1 } } } } }
    }
  ],
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pollSeconds", "releaseLeaseDurationSeconds", "terminationGracePeriodSeconds"],
      "properties": {
        "pollSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "releaseLeaseDurationSeconds": { "type": "integer", "minimum": 30, "maximum": 3600 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 5, "maximum": 300 }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "clusterPreflight"],
      "properties": {
        "create": { "type": "boolean" },
        "clusterPreflight": { "type": "boolean" }
      }
    },
    "resources": { "type": "object" }
  }
}
