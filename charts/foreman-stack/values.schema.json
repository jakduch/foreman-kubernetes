{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["nameOverride", "fullnameOverride", "imagePullSecrets", "secretRolloutToken", "platform", "ingress", "valkey", "sharedSecret", "serviceAccount", "smartProxy", "foreman", "candlepin", "pulp", "migrations", "smokeTest", "recurringTasks", "podDisruptionBudget", "networkPolicy", "affinity", "maintenance", "recovery", "backup", "restore"],
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "secretRolloutToken": { "type": "string", "minLength": 1, "maxLength": 128 },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fqdn", "domain", "externalUrl", "aliases", "trustedProxies"],
      "properties": {
        "fqdn": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "externalUrl": { "type": "string", "pattern": "^https://" },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "trustedProxies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "className", "controller", "foreman", "pulpContent"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string", "minLength": 1 },
        "controller": {
          "const": "k8s.io/ingress-nginx",
          "description": "The rendered authentication and header contracts require ingress-nginx."
        },
        "foreman": { "$ref": "#/definitions/ingressEndpoint" },
        "pulpContent": { "$ref": "#/definitions/ingressEndpoint" }
      }
    },
    "valkey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "foremanCacheUriAuthSecretKey", "dynflowUriAuthSecretKey", "pulpPasswordSecretKey", "tls", "foremanCache", "dynflow", "pulp"],
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1 },
        "foremanCacheUriAuthSecretKey": { "type": "string", "minLength": 1 },
        "dynflowUriAuthSecretKey": { "type": "string", "minLength": 1 },
        "pulpPasswordSecretKey": { "type": "string", "minLength": 1 },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "existingCaSecret", "caSecretKey"],
          "properties": {
            "enabled": { "type": "boolean" },
            "existingCaSecret": { "type": "string" },
            "caSecretKey": { "type": "string", "minLength": 1 }
          }
        },
        "foremanCache": { "$ref": "#/definitions/valkeyEndpoint" },
        "dynflow": { "$ref": "#/definitions/valkeyEndpoint" },
        "pulp": { "$ref": "#/definitions/valkeyEndpoint" }
      }
    },
    "sharedSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "candlepinOAuthSecretKey"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "candlepinOAuthSecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "serviceAccount": { "$ref": "#/definitions/serviceAccount" },
    "smartProxy": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "external",
          "description": "The application chart never embeds Smart Proxy network services in Foreman pods."
        }
      }
    },
    "foreman": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "replicas", "autoscaling", "service", "existingEnvSecret", "databaseUrlSecretKey", "encryptionKeySecretKey", "seedAdminUserSecretKey", "seedAdminPasswordSecretKey", "existingCertificateSecret", "existingDatabaseCaSecret", "database", "enabledPlugins", "pluginPolicy", "puma", "databasePools", "dynflow", "katelloEventDaemon", "sharedTmp", "avatarStorage", "resources"],
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "replicas": { "type": "integer", "minimum": 1 },
        "autoscaling": { "$ref": "#/definitions/autoscaling" },
        "service": { "$ref": "#/definitions/service" },
        "existingEnvSecret": { "type": "string", "minLength": 1 },
        "databaseUrlSecretKey": { "type": "string", "minLength": 1 },
        "encryptionKeySecretKey": { "type": "string", "minLength": 1 },
        "seedAdminUserSecretKey": { "type": "string", "minLength": 1 },
        "seedAdminPasswordSecretKey": { "type": "string", "minLength": 1 },
        "existingCertificateSecret": { "type": "string", "minLength": 1 },
        "existingDatabaseCaSecret": { "type": "string" },
        "database": { "$ref": "#/definitions/databaseTls" },
        "enabledPlugins": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "foreman-tasks",
              "foreman_remote_execution",
              "katello",
              "foreman_google",
              "foreman_azure_rm",
              "foreman_kubevirt",
              "foreman_rh_cloud",
              "foreman_ansible",
              "foreman_webhooks",
              "foreman_virt_who_configure"
            ]
          },
          "allOf": [
            { "contains": { "const": "foreman-tasks" } },
            { "contains": { "const": "katello" } }
          ]
        },
        "pluginPolicy": {
          "type": "object",
          "required": ["allowUnverified"],
          "additionalProperties": false,
          "properties": {
            "allowUnverified": { "type": "boolean" }
          }
        },
        "dynflow": {
          "type": "object",
          "required": ["workers", "workerConcurrency", "hostsQueueWorkers", "hostsQueueConcurrency", "shutdownTimeoutSeconds"],
          "additionalProperties": false,
          "properties": {
            "workers": { "type": "integer", "minimum": 1 },
            "workerConcurrency": { "type": "integer", "minimum": 1 },
            "hostsQueueWorkers": { "type": "integer", "minimum": 1 },
            "hostsQueueConcurrency": { "type": "integer", "minimum": 1 },
            "shutdownTimeoutSeconds": { "type": "integer", "minimum": 25, "maximum": 3600 }
          }
        },
        "puma": {
          "type": "object",
          "required": ["workers", "threadsMin", "threadsMax", "requestDrainSeconds", "terminationGracePeriodSeconds"],
          "additionalProperties": false,
          "properties": {
            "workers": { "type": "integer", "minimum": 1 },
            "threadsMin": { "type": "integer", "minimum": 1 },
            "threadsMax": { "type": "integer", "minimum": 1 },
            "requestDrainSeconds": { "type": "integer", "minimum": 0, "maximum": 300 },
            "terminationGracePeriodSeconds": { "type": "integer", "minimum": 30, "maximum": 3600 }
          }
        },
        "databasePools": {
          "type": "object",
          "required": ["web", "dynflowWorker", "dynflowHostsQueue", "utility"],
          "additionalProperties": false,
          "properties": {
            "web": { "type": "integer", "minimum": 1 },
            "dynflowWorker": { "type": "integer", "minimum": 1 },
            "dynflowHostsQueue": { "type": "integer", "minimum": 1 },
            "utility": { "type": "integer", "minimum": 1 }
          }
        },
        "katelloEventDaemon": {
          "type": "object",
          "required": ["heartbeatIntervalSeconds", "heartbeatStaleSeconds", "resources"],
          "properties": {
            "heartbeatIntervalSeconds": { "type": "integer", "minimum": 1 },
            "heartbeatStaleSeconds": { "type": "integer", "minimum": 2 },
            "resources": { "$ref": "#/definitions/resources" }
          }
        },
        "sharedTmp": {
          "type": "object",
          "required": ["existingClaim", "storageClass", "accessMode", "size"],
          "properties": {
            "existingClaim": { "type": "string" },
            "storageClass": { "type": "string" },
            "accessMode": { "const": "ReadWriteMany" },
            "size": { "type": "string", "minLength": 1 }
          }
        },
        "avatarStorage": {
          "type": "object",
          "required": ["existingClaim", "storageClass", "accessMode", "size"],
          "properties": {
            "existingClaim": { "type": "string" },
            "storageClass": { "type": "string" },
            "accessMode": { "const": "ReadWriteMany" },
            "size": { "type": "string", "minLength": 1 }
          }
        },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "candlepin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "replicas", "existingRuntimeSecret", "databasePasswordSecretKey", "existingCertificateSecret", "existingDatabaseCaSecret", "highAvailability", "database", "java", "shutdown", "service", "resources"],
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "description": "Multiple replicas require the explicit high-availability contract."
        },
        "existingRuntimeSecret": { "type": "string", "minLength": 1 },
        "databasePasswordSecretKey": { "type": "string", "minLength": 1 },
        "existingCertificateSecret": { "type": "string", "minLength": 1 },
        "existingDatabaseCaSecret": { "type": "string" },
        "highAvailability": {
          "type": "object",
          "required": ["enabled", "brokerUrlSecretKey", "existingBrokerTlsSecret", "quartz"],
          "properties": {
            "enabled": { "type": "boolean" },
            "brokerUrlSecretKey": { "type": "string", "minLength": 1 },
            "existingBrokerTlsSecret": { "type": "string" },
            "quartz": {
              "type": "object",
              "required": ["instanceName", "clusterCheckinInterval"],
              "properties": {
                "instanceName": { "type": "string", "minLength": 1 },
                "clusterCheckinInterval": { "type": "integer", "minimum": 1000 }
              }
            }
          }
        },
        "database": { "$ref": "#/definitions/database" },
        "java": {
          "type": "object",
          "required": ["xms", "xmx"],
          "additionalProperties": false,
          "properties": {
            "xms": { "type": "string", "pattern": "^[1-9][0-9]*[kKmMgG]$" },
            "xmx": { "type": "string", "pattern": "^[1-9][0-9]*[kKmMgG]$" }
          }
        },
        "shutdown": {
          "type": "object",
          "required": ["requestDrainSeconds", "asyncJobsTimeoutSeconds", "terminationGracePeriodSeconds"],
          "additionalProperties": false,
          "properties": {
            "requestDrainSeconds": { "type": "integer", "minimum": 0, "maximum": 300 },
            "asyncJobsTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
            "terminationGracePeriodSeconds": { "type": "integer", "minimum": 30, "maximum": 7500 }
          }
        },
        "service": { "$ref": "#/definitions/service" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "pulp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "serviceAccount", "existingRuntimeSecret", "databasePasswordSecretKey", "djangoSecretKey", "existingConfigSecret", "existingDatabaseCaSecret", "database", "contentOrigin", "enabledPlugins", "controlProxy", "api", "content", "workers", "storage", "resources"],
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "serviceAccount": { "$ref": "#/definitions/annotatedServiceAccount" },
        "existingRuntimeSecret": { "type": "string", "minLength": 1 },
        "databasePasswordSecretKey": { "type": "string", "minLength": 1 },
        "djangoSecretKey": { "type": "string", "minLength": 1 },
        "existingConfigSecret": { "type": "string", "minLength": 1 },
        "existingDatabaseCaSecret": { "type": "string" },
        "database": { "$ref": "#/definitions/database" },
        "contentOrigin": { "type": "string", "pattern": "^https?://" },
        "enabledPlugins": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "pulp_certguard",
              "pulp_file",
              "pulp_ansible",
              "pulp_container",
              "pulp_deb",
              "pulp_ostree",
              "pulp_python",
              "pulp_rpm",
              "pulp_smart_proxy"
            ]
          },
          "allOf": [
            { "contains": { "const": "pulp_certguard" } },
            { "contains": { "const": "pulp_file" } },
            { "contains": { "const": "pulp_smart_proxy" } }
          ]
        },
        "api": {
          "type": "object",
          "required": ["replicas", "port", "gunicornWorkers", "gunicornTimeoutSeconds", "gunicornGracefulTimeoutSeconds", "gunicornMaxRequests", "gunicornMaxRequestsJitter", "requestDrainSeconds", "terminationGracePeriodSeconds", "autoscaling"],
          "properties": {
            "replicas": { "type": "integer", "minimum": 1 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "gunicornWorkers": { "type": "integer", "minimum": 1 },
            "gunicornTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "gunicornGracefulTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "gunicornMaxRequests": { "type": "integer", "minimum": 1 },
            "gunicornMaxRequestsJitter": { "type": "integer", "minimum": 0 },
            "requestDrainSeconds": { "type": "integer", "minimum": 0, "maximum": 300 },
            "terminationGracePeriodSeconds": { "type": "integer", "minimum": 30, "maximum": 3600 },
            "autoscaling": { "$ref": "#/definitions/autoscaling" }
          }
        },
        "content": {
          "type": "object",
          "required": ["replicas", "port", "gunicornWorkers", "gunicornTimeoutSeconds", "gunicornGracefulTimeoutSeconds", "requestDrainSeconds", "terminationGracePeriodSeconds", "autoscaling"],
          "properties": {
            "replicas": { "type": "integer", "minimum": 1 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "gunicornWorkers": { "type": "integer", "minimum": 1 },
            "gunicornTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "gunicornGracefulTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "requestDrainSeconds": { "type": "integer", "minimum": 0, "maximum": 300 },
            "terminationGracePeriodSeconds": { "type": "integer", "minimum": 30, "maximum": 3600 },
            "autoscaling": { "$ref": "#/definitions/autoscaling" }
          }
        },
        "workers": {
          "type": "object",
          "required": ["replicas", "terminationGracePeriodSeconds"],
          "additionalProperties": false,
          "properties": {
            "replicas": { "type": "integer", "minimum": 1 },
            "terminationGracePeriodSeconds": { "type": "integer", "minimum": 30 }
          }
        },
        "controlProxy": {
          "type": "object",
          "required": ["image", "replicas", "port", "service", "existingCertificateSecret", "registration", "resources"],
          "properties": {
            "image": { "$ref": "#/definitions/image" },
            "replicas": { "type": "integer", "minimum": 2 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "service": {
              "type": "object",
              "required": ["port"],
              "properties": {
                "port": {
                  "const": 443,
                  "description": "Katello derives Pulp API clients from scheme and host, so the control Service must use the HTTPS default port."
                }
              }
            },
            "existingCertificateSecret": { "type": "string", "minLength": 1 },
            "trustedClientCommonNames": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "registration": {
              "type": "object",
              "required": ["enabled", "retryAttempts", "retryIntervalSeconds"],
              "properties": {
                "enabled": { "type": "boolean" },
                "name": { "type": "string" },
                "retryAttempts": { "type": "integer", "minimum": 1 },
                "retryIntervalSeconds": { "type": "integer", "minimum": 1, "maximum": 60 }
              }
            },
            "resources": { "$ref": "#/definitions/resources" }
          }
        },
        "storage": {
          "type": "object",
          "required": ["backend", "existingClaim", "storageClass", "accessMode", "size", "scratch", "s3"],
          "properties": {
            "backend": { "enum": ["filesystem", "s3"] },
            "existingClaim": { "type": "string" },
            "storageClass": { "type": "string" },
            "accessMode": { "const": "ReadWriteMany" },
            "size": { "type": "string", "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki)$" },
            "scratch": {
              "type": "object",
              "required": ["sizeLimit"],
              "properties": {
                "sizeLimit": { "type": "string", "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki)$" }
              }
            },
            "s3": {
              "type": "object",
              "required": ["bucket", "location", "region", "endpointUrl", "addressingStyle", "signatureVersion", "redirectToObjectStorage", "existingSecret", "accessKeySecretKey", "secretKeySecretKey", "sessionTokenSecretKey", "existingCaSecret", "caSecretKey"],
              "properties": {
                "bucket": { "type": "string" },
                "location": { "type": "string" },
                "region": { "type": "string" },
                "endpointUrl": { "type": "string", "pattern": "^$|^https?://" },
                "addressingStyle": { "enum": ["auto", "path", "virtual"] },
                "signatureVersion": { "type": "string", "minLength": 1 },
                "redirectToObjectStorage": { "type": "boolean" },
                "existingSecret": { "type": "string" },
                "accessKeySecretKey": { "type": "string", "minLength": 1 },
                "secretKeySecretKey": { "type": "string", "minLength": 1 },
                "sessionTokenSecretKey": { "type": "string" },
                "existingCaSecret": { "type": "string" },
                "caSecretKey": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "checkIntervalSeconds", "activeDeadlineSeconds"],
      "properties": {
        "enabled": { "type": "boolean" },
        "checkIntervalSeconds": { "type": "integer", "minimum": 1, "maximum": 60 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 60 }
      }
    },
    "smokeTest": {
      "type": "object",
      "required": ["enabled", "activeDeadlineSeconds", "resources"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 30, "maximum": 1800 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "recurringTasks": {
      "type": "object",
      "required": ["enabled", "timeZone", "startingDeadlineSeconds", "activeDeadlineSeconds", "tasks"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "timeZone": { "type": "string", "minLength": 1 },
        "startingDeadlineSeconds": { "type": "integer", "minimum": 10, "maximum": 86400 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 60, "maximum": 604800 },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "schedule", "rakeTask"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
              "schedule": { "type": "string", "minLength": 1 },
              "rakeTask": { "type": "string", "pattern": "^[a-zA-Z0-9_:.-]+$" }
            }
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingressController", "egress"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressController": {
          "type": "object",
          "required": ["namespaceSelector", "podSelector"],
          "properties": {
            "namespaceSelector": { "type": "object" },
            "podSelector": { "type": "object" }
          }
        },
        "egress": {
          "type": "object",
          "required": ["enabled", "dns", "database", "valkey", "recovery", "external"],
          "properties": {
            "enabled": { "type": "boolean" },
            "dns": { "$ref": "#/definitions/networkPolicyPeer" },
            "database": {
              "type": "object",
              "required": ["peers", "ports"],
              "properties": {
                "peers": { "$ref": "#/definitions/networkPolicyPeers" },
                "ports": { "$ref": "#/definitions/networkPolicyPorts" }
              }
            },
            "valkey": {
              "type": "object",
              "required": ["peers", "ports"],
              "properties": {
                "peers": { "$ref": "#/definitions/networkPolicyPeers" },
                "ports": { "$ref": "#/definitions/networkPolicyPorts" }
              }
            },
            "recovery": {
              "type": "object",
              "additionalProperties": false,
              "required": ["apiServer", "repository"],
              "properties": {
                "apiServer": { "$ref": "#/definitions/networkPolicyDestination" },
                "repository": { "$ref": "#/definitions/networkPolicyDestination" }
              }
            },
            "external": {
              "type": "object",
              "required": ["foreman", "pulp", "candlepin"],
              "properties": {
                "foreman": { "$ref": "#/definitions/networkPolicyDestination" },
                "pulp": { "$ref": "#/definitions/networkPolicyDestination" },
                "candlepin": { "$ref": "#/definitions/networkPolicyDestination" }
              }
            }
          }
        }
      }
    },
    "affinity": {
      "type": "object",
      "required": ["spreadAcrossNodes", "whenUnsatisfiable"],
      "additionalProperties": false,
      "properties": {
        "spreadAcrossNodes": { "type": "boolean" },
        "whenUnsatisfiable": { "enum": ["DoNotSchedule", "ScheduleAnyway"] }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "repository", "work", "activeDeadlineSeconds", "quiescenceTimeoutSeconds", "extraSecretNames", "resources"],
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "repository": {
          "type": "object",
          "required": ["existingSecret", "existingClaim", "path"],
          "properties": {
            "existingSecret": { "type": "string", "minLength": 1 },
            "existingClaim": { "type": "string" },
            "path": { "type": "string", "pattern": "^/" }
          }
        },
        "work": {
          "type": "object",
          "required": ["existingClaim", "sizeLimit"],
          "properties": {
            "existingClaim": { "type": "string" },
            "sizeLimit": { "type": "string", "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki)$" }
          }
        },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 300 },
        "quiescenceTimeoutSeconds": { "type": "integer", "minimum": 30 },
        "resources": { "$ref": "#/definitions/resources" },
        "extraSecretNames": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "requestId", "initializeRepository", "retention"],
      "properties": {
        "enabled": { "type": "boolean" },
        "requestId": { "$ref": "#/definitions/requestId" },
        "initializeRepository": { "type": "boolean" },
        "retention": {
          "type": "object",
          "required": ["enabled", "keepDaily", "keepWeekly", "keepMonthly", "prune"],
          "properties": {
            "enabled": { "type": "boolean" },
            "keepDaily": { "type": "integer", "minimum": 1 },
            "keepWeekly": { "type": "integer", "minimum": 1 },
            "keepMonthly": { "type": "integer", "minimum": 1 },
            "prune": { "type": "boolean" }
          }
        }
      }
    },
    "restore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "requestId", "snapshot", "secrets", "confirmation", "objectStorageConfirmation"],
      "properties": {
        "enabled": { "type": "boolean" },
        "requestId": { "$ref": "#/definitions/requestId" },
        "snapshot": { "type": "string", "minLength": 1 },
        "secrets": { "type": "boolean" },
        "confirmation": { "type": "string" },
        "objectStorageConfirmation": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "foreman": {
            "properties": {
              "pluginPolicy": {
                "properties": { "allowUnverified": { "const": false } }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "foreman": {
            "properties": {
              "enabledPlugins": {
                "items": { "enum": ["foreman-tasks", "katello"] }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "foreman": {
            "properties": {
              "enabledPlugins": { "contains": { "const": "foreman_ansible" } }
            }
          }
        }
      },
      "then": {
        "properties": {
          "foreman": {
            "properties": {
              "enabledPlugins": { "contains": { "const": "foreman_remote_execution" } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "candlepin": {
            "properties": {
              "highAvailability": {
                "properties": { "enabled": { "const": true } }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "candlepin": { "properties": { "replicas": { "minimum": 2 } } },
          "migrations": { "properties": { "enabled": { "const": true } } }
        }
      },
      "else": {
        "properties": {
          "candlepin": { "properties": { "replicas": { "maximum": 1 } } }
        }
      }
    },
    {
      "not": {
        "properties": {
          "backup": { "properties": { "enabled": { "const": true } } },
          "restore": { "properties": { "enabled": { "const": true } } }
        }
      }
    },
    {
      "if": {
        "properties": { "backup": { "properties": { "enabled": { "const": true } } } }
      },
      "then": {
        "properties": {
          "maintenance": { "properties": { "enabled": { "const": true } } },
          "backup": { "properties": { "requestId": { "minLength": 1 } } }
        }
      }
    },
    {
      "if": {
        "properties": { "restore": { "properties": { "enabled": { "const": true } } } }
      },
      "then": {
        "properties": {
          "maintenance": { "properties": { "enabled": { "const": true } } },
          "restore": {
            "properties": {
              "requestId": { "minLength": 1 },
              "confirmation": { "const": "RESTORE" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "networkPolicy": {
            "properties": {
              "egress": { "properties": { "enabled": { "const": true } } }
            }
          }
        }
      },
      "then": {
        "properties": {
          "networkPolicy": { "properties": { "enabled": { "const": true } } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pulp": {
            "properties": {
              "storage": {
                "properties": { "backend": { "const": "s3" } }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "pulp": {
