{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["platform", "ingress", "valkey", "sharedSecret", "foreman", "candlepin", "pulp", "networkPolicy"],
  "properties": {
    "platform": {
      "type": "object",
      "required": ["fqdn", "domain", "externalUrl"],
      "properties": {
        "fqdn": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "externalUrl": { "type": "string", "pattern": "^https://" }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "className", "foreman", "pulpContent"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string", "minLength": 1 },
        "foreman": { "$ref": "#/definitions/ingressEndpoint" },
        "pulpContent": { "$ref": "#/definitions/ingressEndpoint" }
      }
    },
    "valkey": {
      "type": "object",
      "required": ["host", "port"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "sharedSecret": {
      "type": "object",
      "required": ["name", "candlepinOAuthSecretKey"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "candlepinOAuthSecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "foreman": {
      "type": "object",
      "required": ["existingEnvSecret", "existingCertificateSecret"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "existingEnvSecret": { "type": "string", "minLength": 1 },
        "existingCertificateSecret": { "type": "string", "minLength": 1 },
        "dynflow": {
          "type": "object",
          "properties": {
            "workers": { "type": "integer", "minimum": 1 },
            "workerConcurrency": { "type": "integer", "minimum": 1 },
            "hostsQueueWorkers": { "type": "integer", "minimum": 1 },
            "hostsQueueConcurrency": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "candlepin": {
      "type": "object",
      "required": ["existingRuntimeSecret", "existingCertificateSecret", "database"],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1,
          "description": "Candlepin remains single-replica until external Artemis and Quartz clustering are configured."
        },
        "existingRuntimeSecret": { "type": "string", "minLength": 1 },
        "existingCertificateSecret": { "type": "string", "minLength": 1 },
        "database": { "$ref": "#/definitions/database" }
      }
    },
    "pulp": {
      "type": "object",
      "required": ["existingRuntimeSecret", "existingConfigSecret", "database", "contentOrigin", "controlProxy"],
      "properties": {
        "existingRuntimeSecret": { "type": "string", "minLength": 1 },
        "existingConfigSecret": { "type": "string", "minLength": 1 },
        "database": { "$ref": "#/definitions/database" },
        "contentOrigin": { "type": "string", "pattern": "^https?://" },
        "controlProxy": {
          "type": "object",
          "required": ["replicas", "port", "service", "existingCertificateSecret", "registration"],
          "properties": {
            "replicas": { "type": "integer", "minimum": 2 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "service": {
              "type": "object",
              "required": ["port"],
              "properties": {
                "port": {
                  "const": 443,
                  "description": "Katello derives Pulp API clients from scheme and host, so the control Service must use the HTTPS default port."
                }
              }
            },
            "existingCertificateSecret": { "type": "string", "minLength": 1 },
            "trustedClientCommonNames": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "registration": {
              "type": "object",
              "required": ["enabled", "retryAttempts", "retryIntervalSeconds"],
              "properties": {
                "enabled": { "type": "boolean" },
                "name": { "type": "string" },
                "retryAttempts": { "type": "integer", "minimum": 1 },
                "retryIntervalSeconds": { "type": "integer", "minimum": 1, "maximum": 60 }
              }
            }
          }
        },
        "storage": {
          "type": "object",
          "properties": {
            "accessMode": { "const": "ReadWriteMany" },
            "size": { "type": "string", "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki)$" }
          }
        }
      }
    },
    "migrations": {
      "type": "object",
      "required": ["enabled", "checkIntervalSeconds", "activeDeadlineSeconds"],
      "properties": {
        "enabled": { "type": "boolean" },
        "checkIntervalSeconds": { "type": "integer", "minimum": 1, "maximum": 60 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 60 }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "ingressController"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressController": {
          "type": "object",
          "required": ["namespaceSelector", "podSelector"],
          "properties": {
            "namespaceSelector": { "type": "object" },
            "podSelector": { "type": "object" }
          }
        }
      }
    }
  },
  "definitions": {
    "ingressEndpoint": {
      "type": "object",
      "required": ["host", "tlsSecret", "clientCaSecret"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "tlsSecret": { "type": "string", "minLength": 1 },
        "clientCaSecret": { "type": "string", "minLength": 1 },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "database": {
      "type": "object",
      "required": ["host", "port", "name", "user", "sslMode"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "name": { "type": "string", "minLength": 1 },
        "user": { "type": "string", "minLength": 1 },
        "sslMode": { "enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"] }
      }
    }
  }
}
