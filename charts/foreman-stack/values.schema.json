        "properties": {
          "restore": { "properties": { "enabled": { "const": true } } },
          "pulp": {
            "properties": {
              "storage": { "properties": { "backend": { "const": "s3" } } }
            }
          }
        }
      },
      "then": {
        "properties": {
          "restore": {
            "properties": {
              "objectStorageConfirmation": { "const": "BUCKET_RESTORED" }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "serviceAccount": {
      "type": "object",
      "required": ["create", "name"],
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" }
      }
    },
    "annotatedServiceAccount": {
      "type": "object",
      "required": ["create", "name", "annotations"],
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["port"],
      "additionalProperties": false,
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": { "type": "string", "minLength": 1 },
            "memory": { "type": "string", "minLength": 1 }
          }
        },
        "limits": {
          "type": "object",
          "required": ["memory"],
          "properties": {
            "memory": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "requestId": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "networkPolicyPeer": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "ipBlock": {
          "type": "object",
          "required": ["cidr"],
          "properties": {
            "cidr": { "type": "string", "minLength": 1 },
            "except": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "namespaceSelector": { "type": "object" },
        "podSelector": { "type": "object" }
      }
    },
    "networkPolicyPeers": {
      "type": "array",
      "items": { "$ref": "#/definitions/networkPolicyPeer" }
    },
    "networkPolicyPorts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
    },
    "networkPolicyDestination": {
      "type": "object",
      "required": ["peers", "ports"],
      "properties": {
        "peers": { "$ref": "#/definitions/networkPolicyPeers" },
        "ports": { "$ref": "#/definitions/networkPolicyPorts" }
      }
    },
    "autoscaling": {
      "type": "object",
      "required": ["enabled", "minReplicas", "maxReplicas", "targetCPUUtilizationPercentage"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 2 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "ingressEndpoint": {
      "type": "object",
      "required": ["host", "tlsSecret", "clientCaSecret"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "tlsSecret": { "type": "string", "minLength": 1 },
        "clientCaSecret": { "type": "string", "minLength": 1 },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "database": {
      "type": "object",
      "required": ["host", "port", "name", "user", "sslMode"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "name": { "type": "string", "minLength": 1 },
        "user": { "type": "string", "minLength": 1 },
        "sslMode": { "enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"] }
      }
    },
    "databaseTls": {
      "type": "object",
      "required": ["sslMode"],
      "additionalProperties": false,
      "properties": {
        "sslMode": { "enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"] }
      }
    },
    "valkeyEndpoint": {
      "type": "object",
      "required": ["host", "port", "database"],
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "database": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
